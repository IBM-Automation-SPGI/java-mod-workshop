<?xml version="1.0" encoding="UTF-8"?>
<!--
  ejb-jar.xml — Descriptor de despliegue estándar Java EE para el módulo EJB de PedjasApp.

  Define los EJBs del módulo, incluyendo:
    - ProductoBean: EJB 2.x Entity Bean con CMP
    - PedidoServiceBean: EJB 3.x Stateless Session Bean
    - NotificacionBean: EJB 3.x Stateless Session Bean

  Versión Java EE: 7 / EJB: 3.2
  Compatible con tWAS 8.5 y 9.0.
-->
<ejb-jar
    xmlns="http://xmlns.jcp.org/xml/ns/javaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                        http://xmlns.jcp.org/xml/ns/javaee/ejb-jar_3_2.xsd"
    version="3.2">

    <display-name>pedjasapp-ejb</display-name>
    <description>Módulo EJB de PedjasApp — Lógica de Negocio y Persistencia</description>

    <enterprise-beans>

        <!-- ═══════════════════════════════════════════════════════════════════
             EJB 2.x CMP Entity Bean — ProductoBean
             NOTA AMA — RULE-0002: Este tipo de EJB no está soportado en Liberty.
             ═══════════════════════════════════════════════════════════════════ -->
        <entity>
            <display-name>ProductoEJB</display-name>
            <ejb-name>ProductoEJB</ejb-name>

            <local-home>com.pedjas.ejb.ProductoLocalHome</local-home>
            <local>com.pedjas.ejb.ProductoLocal</local>
            <ejb-class>com.pedjas.ejb.ProductoBean</ejb-class>

            <!-- CMP: persistencia gestionada por el contenedor tWAS -->
            <persistence-type>Container</persistence-type>
            <prim-key-class>java.lang.Long</prim-key-class>
            <reentrant>false</reentrant>
            <cmp-version>2.x</cmp-version>
            <abstract-schema-name>Producto</abstract-schema-name>

            <!-- Campos CMP — gestionados automáticamente por tWAS -->
            <cmp-field><field-name>id</field-name></cmp-field>
            <cmp-field><field-name>nombre</field-name></cmp-field>
            <cmp-field><field-name>descripcion</field-name></cmp-field>
            <cmp-field><field-name>precio</field-name></cmp-field>
            <cmp-field><field-name>categoria</field-name></cmp-field>
            <cmp-field><field-name>stock</field-name></cmp-field>

            <primkey-field>id</primkey-field>

            <!-- Consultas EJB-QL para los finders y select -->
            <query>
                <description>Buscar todos los productos</description>
                <query-method>
                    <method-name>findAll</method-name>
                    <method-params/>
                </query-method>
                <ejb-ql>SELECT OBJECT(p) FROM Producto AS p ORDER BY p.nombre</ejb-ql>
            </query>

            <query>
                <description>Buscar productos por categoría</description>
                <query-method>
                    <method-name>findByCategoria</method-name>
                    <method-params>
                        <method-param>java.lang.String</method-param>
                    </method-params>
                </query-method>
                <ejb-ql>SELECT OBJECT(p) FROM Producto AS p WHERE p.categoria = ?1</ejb-ql>
            </query>

            <query>
                <description>Select por categoría — usado internamente por ProductoBean</description>
                <query-method>
                    <method-name>ejbSelectByCategoria</method-name>
                    <method-params>
                        <method-param>java.lang.String</method-param>
                    </method-params>
                </query-method>
                <ejb-ql>SELECT OBJECT(p) FROM Producto AS p WHERE p.categoria = ?1</ejb-ql>
            </query>
        </entity>

        <!-- ═══════════════════════════════════════════════════════════════════
             EJB 3.x Stateless Session Bean — PedidoServiceBean
             ═══════════════════════════════════════════════════════════════════ -->
        <session>
            <display-name>PedidoServiceEJB</display-name>
            <ejb-name>PedidoServiceEJB</ejb-name>

            <business-local>com.pedjas.ejb.PedidoServiceLocal</business-local>
            <ejb-class>com.pedjas.ejb.PedidoServiceBean</ejb-class>
            <session-type>Stateless</session-type>
            <transaction-type>Container</transaction-type>

            <!-- Referencia al DataSource — NOTA AMA — RULE-0003 -->
            <resource-ref>
                <res-ref-name>jdbc/pedjasappDS</res-ref-name>
                <res-type>javax.sql.DataSource</res-type>
                <res-auth>Container</res-auth>
            </resource-ref>

            <!-- Referencia al Home del ProductoEJB — NOTA AMA — RULE-0006 -->
            <ejb-local-ref>
                <ejb-ref-name>ejb/ProductoEJB</ejb-ref-name>
                <ejb-ref-type>Entity</ejb-ref-type>
                <local-home>com.pedjas.ejb.ProductoLocalHome</local-home>
                <local>com.pedjas.ejb.ProductoLocal</local>
                <ejb-link>ProductoEJB</ejb-link>
            </ejb-local-ref>
        </session>

        <!-- ═══════════════════════════════════════════════════════════════════
             EJB 3.x Stateless Session Bean — NotificacionBean
             ═══════════════════════════════════════════════════════════════════ -->
        <session>
            <display-name>NotificacionEJB</display-name>
            <ejb-name>NotificacionEJB</ejb-name>

            <business-local>com.pedjas.ejb.NotificacionLocal</business-local>
            <ejb-class>com.pedjas.ejb.NotificacionBean</ejb-class>
            <session-type>Stateless</session-type>
            <transaction-type>Container</transaction-type>

            <!-- Referencia JMS — NOTA AMA — RULE-0005 -->
            <resource-ref>
                <res-ref-name>jms/PedjasQCF</res-ref-name>
                <res-type>javax.jms.QueueConnectionFactory</res-type>
                <res-auth>Container</res-auth>
            </resource-ref>

            <message-destination-ref>
                <message-destination-ref-name>jms/PedjasNotificacionesQ</message-destination-ref-name>
                <message-destination-type>javax.jms.Queue</message-destination-type>
                <message-destination-usage>Produces</message-destination-usage>
                <message-destination-link>PedjasNotificacionesQueue</message-destination-link>
            </message-destination-ref>
        </session>

    </enterprise-beans>

    <!-- ═══════════════════════════════════════════════════════════════════
         Configuración del contenedor para el ProductoEJB (CMP)
         ═══════════════════════════════════════════════════════════════════ -->
    <assembly-descriptor>
        <container-transaction>
            <method>
                <ejb-name>PedidoServiceEJB</ejb-name>
                <method-name>*</method-name>
            </method>
            <trans-attribute>Required</trans-attribute>
        </container-transaction>

        <container-transaction>
            <method>
                <ejb-name>NotificacionEJB</ejb-name>
                <method-name>*</method-name>
            </method>
            <trans-attribute>Required</trans-attribute>
        </container-transaction>
    </assembly-descriptor>

</ejb-jar>
